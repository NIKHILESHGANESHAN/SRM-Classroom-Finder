erDiagram
  %% SRM KTR Classroom Finder — Entity-Relationship diagram
  %% Cardinalities: ||--o{  one-to-many ; }o--||  many-to-one

  buildings {
    text id PK
    varchar code UK "unique"
    varchar name
  }

  floors {
    text id PK
    text building_id FK
    int floor_number
  }

  time_slots {
    text id PK
    int slot_order UK "unique"
    time start_time
    time end_time
  }

  classrooms {
    text id PK
    text building_id FK
    text floor_id FK
    varchar room_number
  }

  free_reports {
    text id PK
    text classroom_id FK
    text time_slot_id FK
    date report_date
    varchar contributor_token
    FreeReportStatus status
    int confirmation_count
    timestamp created_at
    timestamp expires_at
  }

  occupied_reports {
    text id PK
    text free_report_id FK
    varchar reporter_token
    OccupiedReason reason
    timestamp created_at
  }

  buildings ||--o{ floors : "has"
  buildings ||--o{ classrooms : "contains"
  floors ||--o{ classrooms : "locates"
  time_slots ||--o{ free_reports : "schedules"
  classrooms ||--o{ free_reports : "claimed_free"
  free_reports ||--o{ occupied_reports : "flagged_by"

