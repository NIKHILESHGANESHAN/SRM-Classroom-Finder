# PostgreSQL connection string (Neon, Supabase, or local Docker)
# Required from Phase 2 onward — not used in Phase 1 scaffold.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret for protecting the Vercel Cron expiry route (Phase 8)
CRON_SECRET="replace-with-a-long-random-string"
