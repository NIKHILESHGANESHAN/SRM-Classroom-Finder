# =============================================================================
# Copy to `.env` and fill in values. Never commit real secrets.
# =============================================================================

# PostgreSQL connection string (required from Phase 2 onward)
# Local Docker (docker compose up -d):
# DATABASE_URL="postgresql://srm:srm@localhost:5432/srm_classroom_finder"
# Neon / Supabase (production / cloud):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DATABASE_URL="postgresql://srm:srm@localhost:5432/srm_classroom_finder"

# Secret for protecting the Vercel Cron expiry route (Phase 8)
# Validated at startup via Zod (lib/env.ts) — min 8 characters.
CRON_SECRET="replace-with-a-long-random-string"

# Private /admin console (V2.6). Server-only — never prefix with NEXT_PUBLIC.
# Distinct from CRON_SECRET. Min 16 characters.
ADMIN_SECRET="replace-with-a-separate-long-admin-secret"

# Unsafe override for scripts/seed-stats-data.ts (DEVELOPMENT/DEMO ONLY).
# Never set this on production. Leave unset.
# ALLOW_DEMO_STATS_SEED="true"

# Canonical public URL for Open Graph / metadataBase (Phase 11)
# Optional locally (defaults to http://localhost:3000).
# Set this on Vercel to your production domain, e.g.:
# NEXT_PUBLIC_APP_URL="https://srm-classroom-finder.vercel.app"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
